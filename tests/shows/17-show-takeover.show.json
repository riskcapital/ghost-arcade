{
  "name": "Show timeline: live takeover",
  "description": "A VJ deck row takes over a show track and hands it back: a cut in, a 1 s fade release, a release quantised to the next bar of the show's tempo map, and the show paused underneath with its time unchanged. A MIDI note held on show:live engages it and the note-off releases it.",
  "steps": [
    {
      "do": "app.start",
      "choice": "blank"
    },
    {
      "do": "project.layer",
      "name": "Wall",
      "colour": "red"
    },
    {
      "do": "show.open"
    },
    {
      "do": "show.track",
      "name": "wall",
      "layer": "Wall"
    },
    {
      "do": "show.clip",
      "track": "wall",
      "layerContent": true,
      "at": 0,
      "duration": 30
    },
    {
      "do": "deck.shader",
      "row": 1,
      "col": 0,
      "shader": "DM-SolidColor",
      "values": {
        "baseColor": [
          0,
          0,
          1,
          1
        ]
      }
    },
    {
      "do": "deck.trigger",
      "row": 1,
      "col": 0
    },
    {
      "do": "show.seek",
      "t": 2,
      "settle": 1200,
      "label": "The show's track plays the red layer; VJ mode is closed",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            0,
            0
          ],
          "within": 0.03
        },
        "eval.true": {
          "js": "!__show.deck().isOpen && !__show.deck().isLive",
          "label": "VJ mode closed and not live"
        }
      }
    },
    {
      "do": "takeover.engage",
      "track": "wall",
      "deck": "A",
      "row": 1,
      "settle": 2000,
      "label": "Take the track over with deck A row 2 (blue): the output is blue",
      "expect": {
        "output.rgb": {
          "rgb": [
            0,
            0,
            1
          ],
          "within": 0.03
        },
        "takeover.count": {
          "is": 1
        },
        "eval.true": {
          "js": "__show.deck().takeoverLive === true && __show.deck().isLive === false",
          "label": "VJ feeds run for the takeover; VJ mode's Live is untouched"
        }
      }
    },
    {
      "do": "takeover.release",
      "track": "wall",
      "mode": "fade",
      "fade": 1
    },
    {
      "do": "wait",
      "seconds": 0.5,
      "label": "Fade release of 1 s, half way: red and blue mixed",
      "expect": {
        "output.rgb": {
          "rgb": [
            0.5,
            0,
            0.5
          ],
          "within": 0.12
        }
      }
    },
    {
      "do": "wait",
      "seconds": 0.7,
      "label": "1.2 s after the release: back to the show's red",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            0,
            0
          ],
          "within": 0.03
        },
        "takeover.count": {
          "is": 0
        },
        "eval.true": {
          "js": "__show.deck().takeoverLive === false",
          "label": "VJ feeds stop with the takeover"
        }
      }
    },
    {
      "do": "show.tempo",
      "bpm": 120,
      "offset": 0
    },
    {
      "do": "wait",
      "seconds": 0.2,
      "label": "Bar-quantised release on the playing show lands on the bar (within one frame)",
      "expect": {
        "takeover.barRelease": {
          "track": "wall",
          "source": {
            "kind": "vjRow",
            "deck": "A",
            "row": 1
          },
          "from": 1,
          "askAt": 2.6,
          "until": 4.6
        }
      }
    },
    {
      "do": "wait",
      "seconds": 0.6,
      "label": "After the bar: the show's red again",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            0,
            0
          ],
          "within": 0.03
        },
        "takeover.count": {
          "is": 0
        }
      }
    },
    {
      "do": "show.play",
      "from": 6
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "takeover.underneath",
      "mode": "pause"
    },
    {
      "do": "eval",
      "js": "__show.vars.pausedAt = null; true"
    },
    {
      "do": "takeover.engage",
      "track": "wall",
      "deck": "A",
      "row": 1,
      "settle": 100
    },
    {
      "do": "eval",
      "js": "(__show.vars.pausedAt = __show.show().currentTime, true)"
    },
    {
      "do": "wait",
      "seconds": 1.5,
      "label": "'pause' underneath: the takeover paused the show and its time stands still",
      "expect": {
        "output.rgb": {
          "rgb": [
            0,
            0,
            1
          ],
          "within": 0.03
        },
        "eval.true": {
          "js": "!__show.show().isPlaying && Math.abs(__show.show().currentTime - __show.vars.pausedAt) < 1e-9",
          "label": "show paused at the engage time"
        }
      }
    },
    {
      "do": "takeover.release",
      "track": "wall",
      "mode": "instant",
      "settle": 50,
      "label": "Hand back: the show carries on from where it was paused",
      "expect": {
        "eval.true": {
          "js": "__show.show().isPlaying && __show.show().currentTime - __show.vars.pausedAt < 0.2",
          "label": "show playing again from the paused time"
        }
      }
    },
    {
      "do": "show.pause"
    },
    {
      "do": "takeover.underneath",
      "mode": "run"
    },
    {
      "do": "eval",
      "js": "__show.g().showControl.midiRouter.dispatchPath('show:live:1:vja:2:hold', 1, { inputId: 'midi:note:36' })"
    },
    {
      "do": "wait",
      "seconds": 1.2,
      "label": "MIDI note-on on show:live:1:vja:2:hold: the track is taken over and the transport says LIVE 1",
      "expect": {
        "output.rgb": {
          "rgb": [
            0,
            0,
            1
          ],
          "within": 0.03
        },
        "eval.true": {
          "js": "document.querySelector('[data-takeover-pill]')?.textContent.trim() === 'LIVE 1' && /LIVE \u00b7 VJ A2/.test(document.querySelector('[data-takeover-badge]')?.textContent ?? '')",
          "label": "LIVE pill and the track header's LIVE \u00b7 VJ A2"
        }
      }
    },
    {
      "do": "eval",
      "js": "__show.g().showControl.midiRouter.dispatchPath('show:live:1:vja:2:hold', 0, { inputId: 'midi:note:36' })"
    },
    {
      "do": "wait",
      "seconds": 1.4,
      "label": "Note-off (value 0) hands the track back (1 s fade)",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            0,
            0
          ],
          "within": 0.03
        },
        "eval.true": {
          "js": "!document.querySelector('[data-takeover-pill]')",
          "label": "LIVE pill gone"
        }
      }
    },
    {
      "do": "wait",
      "seconds": 0.6,
      "label": "Red again, nothing taken over, no errors",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            0,
            0
          ],
          "within": 0.03
        },
        "takeover.count": {
          "is": 0
        },
        "noErrors": true
      }
    }
  ]
}
