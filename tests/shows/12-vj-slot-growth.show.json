      "clip": "green.mp4"
    },
    {
      "do": "deck.triggerColumn",
      "col": 0,
      "wait": 6,
      "label": "Play all 28 rows",
      "expect": {
        "output.colour": {
          "is": "white",
          "within": 5
        },
        "rows.match": {
          "rows": 28,
          "within": 5
        },
        "noErrors": true
      }
    },
    {
      "do": "deck.fader",
      "row": 0,
      "value": 0,
      "wait": 1.5,
      "label": "Top fader down",
      "expect": {
        "output.colour": {
