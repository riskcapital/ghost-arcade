{
  "name": "VJ deck: 28 rows need more than the first 48 picture slots",
  "description": "Two slots per row plus the mix passes past the 48 slots the core starts with. The store grows, every row still draws its own clip, and the output is the stack.",
  "steps": [
    {
      "do": "app.start",
      "choice": "blank"
    },
    {
      "do": "deck.open"
    },
    {
      "do": "deck.rows",
      "count": 28
    },
    {
      "do": "deck.drop",
