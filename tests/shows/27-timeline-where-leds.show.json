{
  "name": "Timeline: a look travelling across the pieces, and LED rows",
  "description": "A where line on a look block sweeps it left to right across three pieces (one pass in three bars), checked on the render core's real pixels at three times and scrubbed back. An LED row then shows a colour block and follows the stage, checked on the packets a fake WLED controller receives; between blocks the row is dark.",
  "steps": [
    { "do": "app.start", "choice": "blank" },
    { "do": "wled.listen" },
    { "do": "project.layer", "name": "Left", "colour": "black", "x0": 0, "x1": 0.3 },
    { "do": "project.layer", "name": "Middle", "colour": "black", "x0": 0.35, "x1": 0.65 },
    { "do": "project.layer", "name": "Right", "colour": "red", "x0": 0.7, "x1": 1, "wait": 1 },
    { "do": "wled.controller", "id": "strip", "name": "Window strip", "leds": 30 },
    { "do": "show.open", "doc": "timeline" },
    { "do": "show.look", "look": "stripe-sweep", "palette": "acid", "at": 0, "duration": 6, "var": "sweep" },
    { "do": "show.where", "look": "sweep", "where": { "order": "left-right", "members": "pieces", "motion": { "kind": "sweep", "bars": 3 }, "soft": 0 } },
    { "do": "show.led", "row": "led:strip", "at": 8, "duration": 2, "kind": "colour", "color": "#ff8000", "var": "amber" },
    { "do": "show.led", "row": "led:strip", "at": 10, "duration": 2, "kind": "follow" },
    { "do": "show.led", "row": "led:strip", "at": 13, "duration": 1, "kind": "colour", "color": "#ffffff" },
    { "do": "show.seek", "t": 1, "settle": 1500, "label": "t=1: the look is on Left only",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "min": 0.06 } } },
    { "do": "show.seek", "t": 1.01, "settle": 200, "label": "t=1: Middle stays dark",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "max": 0.03 } } },
    { "do": "show.seek", "t": 3, "settle": 1500, "label": "t=3: the look has moved to Middle",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "min": 0.06 } } },
    { "do": "show.seek", "t": 3.01, "settle": 200, "label": "t=3: Left is dark again",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "max": 0.03 } } },
    { "do": "show.seek", "t": 5, "settle": 1500, "label": "t=5: the look is on Right (over its red), Middle dark",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "max": 0.03 } } },
    { "do": "show.seek", "t": 1, "settle": 1500, "label": "Scrubbed back to t=1: Left again",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "min": 0.06 } } },
    { "do": "show.seek", "t": 7, "settle": 600, "label": "t=7: the LED row has blocks, none here: black frames",
      "expect": { "wled.packet": { "black": true } } },
    { "do": "show.seek", "t": 9, "settle": 300, "label": "t=9: the colour block: every LED amber",
      "expect": { "wled.packet": { "rgb": [255, 128, 0], "tolerance": 2 } } },
    { "do": "show.seek", "t": 11, "settle": 300, "label": "t=11: follow the stage: the LEDs show the projected picture (red on the right)",
      "expect": { "wled.packet": { "output": true, "at": [0.1, 0.5, 0.9], "tolerance": 30 } } },
    { "do": "show.seek", "t": 11.01, "settle": 100, "label": "t=11: the right end of the strip is red",
      "expect": { "wled.packet": { "from": 26, "to": 30, "rgb": [255, 0, 0], "tolerance": 12 } } },
    { "do": "show.seek", "t": 12.5, "settle": 300, "label": "t=12.5: between blocks again: dark",
      "expect": { "wled.packet": { "black": true }, "noErrors": true } }
  ]
}
