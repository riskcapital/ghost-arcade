{
  "name": "Show timeline: track crossfades off stage and under a preset dissolve",
  "description": "A track whose layer is not on stage keeps showing its outgoing clip through a crossfade into a faded-in clip, and has no black frame at the start of a plain crossfade. Under a preset dissolve between presets that share the tracked layer, the clip shows on both sides: no dip to the layer's own content.",
  "steps": [
    { "do": "app.start", "choice": "blank" },
    { "do": "project.layer", "name": "Wall", "colour": "white" },
    { "do": "project.layer", "name": "Floor", "colour": "green", "wait": 1 },
    { "do": "show.open" },
    { "do": "show.track", "name": "wall", "layer": "Wall" },
    { "do": "show.track", "name": "floor", "layer": "Floor" },
    { "do": "project.removeLayer", "name": "Wall" },
    { "do": "preset.save", "name": "A" },
    { "do": "preset.save", "name": "B" },
    { "do": "show.clip", "track": "wall", "colour": "red", "at": 0, "duration": 4 },
    { "do": "show.clip", "track": "wall", "colour": "blue", "at": 4, "duration": 4, "transitionIn": "dissolve", "transitionDuration": 2, "fadeIn": 2 },
    { "do": "show.clip", "track": "wall", "colour": "yellow", "at": 8, "duration": 4 },
    { "do": "show.clip", "track": "wall", "colour": "cyan", "at": 12, "duration": 4, "transitionIn": "dissolve", "transitionDuration": 2 },
    { "do": "show.preset", "name": "A", "at": 0, "duration": 20 },
    { "do": "show.preset", "name": "B", "at": 20, "duration": 20, "cut": false },
    { "do": "show.clip", "track": "floor", "colour": "magenta", "at": 16, "duration": 24 },
    { "do": "eval", "js": "(() => { const st = __show.g().showTimeline; const b = __show.show().presetClips[1]; st.setTransitionStyle(b.id, 'dissolve'); st.setTransitionDuration(b.id, 4); return true; })()" },
    { "do": "show.seek", "t": 2, "settle": 1500, "label": "Before the crossfade: the off-stage Wall plays red",
      "expect": { "eval.true": { "js": "__show.trackLayerId('wall').startsWith('showtrack::')", "label": "Wall is off stage" },
        "output.rgb": { "rgb": [1, 0, 0], "within": 0.06 } } },
    { "do": "show.seek", "t": 3.5, "settle": 1500, "label": "First half of a crossfade into a faded-in clip: still red (the outgoing clip at its dissolve weight)",
      "expect": { "output.rgb": { "rgb": [0.924, 0, 0], "within": 0.08 } } },
    { "do": "show.seek", "t": 10, "settle": 1500, "label": "Yellow plays",
      "expect": { "output.rgb": { "rgb": [1, 1, 0], "within": 0.06 } } },
    { "do": "show.seek", "t": 11, "settle": 1200, "label": "First frame of a plain crossfade: yellow, not black",
      "expect": { "output.rgb": { "rgb": [1, 1, 0], "within": 0.06 } } },
    { "do": "show.seek", "t": 18, "settle": 1500, "label": "Floor plays magenta under preset A",
      "expect": { "layer.colour": { "track": "floor", "is": "magenta", "within": 10 },
        "output.rgb": { "rgb": [1, 0, 1], "within": 0.06 } } },
    { "do": "show.seek", "t": 19.5, "settle": 1500, "label": "Preset dissolve, before the swap: magenta on both sides, none of the layer's own green",
      "expect": { "output.rgb": { "rgb": [0.925, 0, 0.925], "within": 0.08 } } },
    { "do": "show.seek", "t": 20.5, "settle": 1500, "label": "Preset dissolve, after the swap: still magenta, no green",
      "expect": { "output.rgb": { "rgb": [0.925, 0, 0.925], "within": 0.08 }, "noErrors": true } }
  ]
}
