{
  "name": "Timeline: row crossfades off stage",
  "description": "A row whose piece is no longer on the stage (Wall, removed after its row got blocks) plays from its own copy; it keeps showing its outgoing block through a crossfade into a faded-in block, and has no black frame at the start of a plain crossfade.",
  "steps": [
    {
      "do": "app.start",
      "choice": "blank"
    },
    {
      "do": "project.layer",
      "name": "Wall",
      "colour": "white"
    },
    {
      "do": "project.layer",
      "name": "Floor",
      "colour": "green",
      "wait": 1
    },
    {
      "do": "show.open",
      "doc": "timeline"
    },
    {
      "do": "show.track",
      "name": "wall",
      "layer": "Wall"
    },
    {
      "do": "show.track",
      "name": "floor",
      "layer": "Floor"
    },
    {
      "do": "show.clip",
      "track": "wall",
      "colour": "red",
      "at": 0,
      "duration": 4
    },
    {
      "do": "show.clip",
      "track": "wall",
      "colour": "blue",
      "at": 4,
      "duration": 4,
      "transitionIn": "dissolve",
      "transitionDuration": 2,
      "fadeIn": 2
    },
    {
      "do": "show.clip",
      "track": "wall",
      "colour": "yellow",
      "at": 8,
      "duration": 4
    },
    {
      "do": "show.clip",
      "track": "wall",
      "colour": "cyan",
      "at": 12,
      "duration": 4,
      "transitionIn": "dissolve",
      "transitionDuration": 2
    },
    {
      "do": "show.clip",
      "track": "floor",
      "colour": "magenta",
      "at": 16,
      "duration": 24
    },
    {
      "do": "project.removeLayer",
      "name": "Wall",
      "wait": 1
    },
    {
      "do": "show.seek",
      "t": 2,
      "settle": 1500,
      "label": "Before the crossfade: the off-stage Wall plays red",
      "expect": {
        "eval.true": {
          "js": "__show.trackLayerId('wall').startsWith('showtrack::')",
          "label": "Wall is off stage"
        },
        "output.rgb": {
          "rgb": [
            1,
            0,
            0
          ],
          "within": 0.06
        }
      }
    },
    {
      "do": "show.seek",
      "t": 3.5,
      "settle": 1500,
      "label": "First half of a crossfade into a faded-in clip: still red (the outgoing clip at its dissolve weight)",
      "expect": {
        "output.rgb": {
          "rgb": [
            0.924,
            0,
            0
          ],
          "within": 0.08
        }
      }
    },
    {
      "do": "show.seek",
      "t": 10,
      "settle": 1500,
      "label": "Yellow plays",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            1,
            0
          ],
          "within": 0.06
        }
      }
    },
    {
      "do": "show.seek",
      "t": 11,
      "settle": 1200,
      "label": "First frame of a plain crossfade: yellow, not black",
      "expect": {
        "output.rgb": {
          "rgb": [
            1,
            1,
            0
          ],
          "within": 0.06
        }
      }
    },
    {
      "do": "show.seek",
      "t": 18,
      "settle": 1500,
      "label": "Floor plays magenta",
      "expect": {
        "layer.colour": {
          "track": "floor",
          "is": "magenta",
          "within": 10
        },
        "output.rgb": {
          "rgb": [
            1,
            0,
            1
          ],
          "within": 0.06
        },
        "noErrors": true
      }
    }
  ]
}
