{
  "name": "Show and Timeline: presets on the Show, rows on the Timeline",
  "description": "The Show plays presets and has no rows. On the Timeline a row keeps driving its piece when a preset loaded from the Presets tray swaps the layers underneath, and a row whose piece is not in the loaded preset plays it from its own copy. Opening the Timeline while the Show plays stops the Show: only one plays.",
  "steps": [
    { "do": "app.start", "choice": "blank" },
    { "do": "project.layer", "name": "Wall", "colour": "red" },
    { "do": "project.layer", "name": "Floor", "colour": "blue", "wait": 1 },
    { "do": "preset.save", "name": "A" },
    { "do": "project.layerColour", "name": "Wall", "colour": "white" },
    { "do": "preset.save", "name": "B" },
    { "do": "project.removeLayer", "name": "Floor" },
    { "do": "preset.save", "name": "C" },
    { "do": "show.open" },
    { "do": "show.preset", "name": "A", "at": 0, "duration": 5 },
    { "do": "show.preset", "name": "B", "at": 5, "duration": 5 },
    { "do": "show.seek", "t": 7, "settle": 1500, "label": "The Show plays its presets and has no rows",
      "expect": { "eval.true": { "js": "__show.project().vjMode.activeCompositionId === __show.vars['preset:B'] && __show.show().layerTracks.length === 0 && __show.show().doc === 'show'", "label": "preset B loaded, no rows" } } },
    { "do": "show.play", "from": 0, "wait": 1 },
    { "do": "show.open", "doc": "timeline", "label": "Opening the Timeline stops the Show",
      "expect": { "eval.true": { "js": "!__show.show().isPlaying && __show.show().presetClips.length === 0 && __show.tracks().activeDoc() === 'timeline'", "label": "nothing plays; the Timeline has no presets" } } },
    { "do": "eval", "js": "(() => { __show.g().project.loadComposition(__show.vars['preset:A']); return true; })()", "wait": 1 },
    { "do": "show.track", "name": "wall", "layer": "Wall" },
    { "do": "show.track", "name": "floor", "layer": "Floor" },
    { "do": "show.clip", "track": "wall", "colour": "green", "at": 0, "duration": 15 },
    { "do": "show.clip", "track": "floor", "colour": "magenta", "at": 0, "duration": 15 },
    { "do": "show.seek", "t": 2, "settle": 1500, "label": "Preset A on stage: both rows play their blocks",
      "expect": { "layer.colour": { "track": "wall", "is": "green", "within": 10 },
        "eval.true": { "js": "__show.trackLayerId('floor') === __show.layerByName('Floor')?.id", "label": "Floor is on stage and driven in place" } } },
    { "label": "Floor plays its block", "expect": { "layer.colour": { "track": "floor", "is": "magenta", "within": 10 } } },
    { "do": "eval", "js": "(() => { __show.g().project.loadComposition(__show.vars['preset:B']); return true; })()", "wait": 1 },
    { "do": "show.seek", "t": 7, "settle": 1500, "label": "Preset B swapped the layers: the Wall row still drives Wall",
      "expect": { "layer.colour": { "track": "wall", "is": "green", "within": 10 } } },
    { "do": "eval", "js": "(() => { __show.g().project.loadComposition(__show.vars['preset:C']); return true; })()", "wait": 1 },
    { "do": "show.seek", "t": 12, "settle": 1500, "label": "Preset C has no Floor: its row plays the piece from its own copy",
      "expect": { "eval.true": { "js": "__show.trackLayerId('floor').startsWith('showtrack::')", "label": "Floor is off stage" },
        "layer.colour": { "track": "floor", "is": "magenta", "within": 10 } } },
    { "label": "The Wall row still plays under preset C", "expect": { "layer.colour": { "track": "wall", "is": "green", "within": 10 }, "noErrors": true } }
  ]
}
