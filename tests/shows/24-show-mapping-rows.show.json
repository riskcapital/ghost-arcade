{
  "name": "Show timeline: a mapping show on two pieces",
  "description": "Two pieces side by side, each its own row. Blocks play on each at different times, a row with blocks hides its piece where it has none, a layer added on a piece draws over it with Add, and a shader input edited on one block changes that block only (not the mapping layer). Checked on the render core's real pixels, left half and right half.",
  "steps": [
    { "do": "app.start", "choice": "blank" },
    { "do": "project.layer", "name": "Left", "colour": "white", "x0": 0, "x1": 0.5 },
    { "do": "project.layer", "name": "Right", "colour": "white", "x0": 0.5, "x1": 1, "wait": 1 },
    { "do": "show.open" },
    { "do": "show.track", "name": "left", "layer": "Left" },
    { "do": "show.track", "name": "right", "layer": "Right" },
    { "do": "show.seek", "t": 1, "settle": 1200, "label": "No blocks yet: both pieces show their look (white)",
      "expect": { "output.region": { "x0": 0, "x1": 0.5, "rgb": [1, 1, 1], "within": 0.06 },
        "eval.true": { "js": "__show.show().layerTracks.filter((t) => t.row && t.row.kind === 'piece').length === 2", "label": "a row per mapping layer" } } },
    { "do": "show.clip", "track": "left", "colour": "blue", "at": 0, "duration": 4, "var": "leftBlock" },
    { "do": "show.clip", "track": "right", "colour": "green", "at": 2, "duration": 6 },
    { "do": "show.subRow", "name": "glow", "track": "right" },
    { "do": "show.clip", "track": "glow", "colour": "red", "at": 3, "duration": 5, "blendMode": "add" },
    { "do": "show.seek", "t": 1, "settle": 1500, "label": "t=1: blue on the left; the right row has blocks but none yet, so its piece is hidden",
      "expect": { "output.region": { "x0": 0, "x1": 0.5, "rgb": [0, 0, 1], "within": 0.06 } } },
    { "do": "show.seek", "t": 1.01, "settle": 400, "label": "Right piece hidden (black)",
      "expect": { "output.region": { "x0": 0.5, "x1": 1, "rgb": [0, 0, 0], "within": 0.04 } } },
    { "do": "show.seek", "t": 2.5, "settle": 1500, "label": "t=2.5: the right block plays green",
      "expect": { "output.region": { "x0": 0.5, "x1": 1, "rgb": [0, 1, 0], "within": 0.06 } } },
    { "do": "show.seek", "t": 3.5, "settle": 1500, "label": "t=3.5: the added layer (red, Add) over green reads yellow",
      "expect": { "output.region": { "x0": 0.5, "x1": 1, "rgb": [1, 1, 0], "within": 0.08 } } },
    { "do": "show.seek", "t": 5, "settle": 1500, "label": "t=5: the left row has no block here: the left piece is hidden",
      "expect": { "output.region": { "x0": 0, "x1": 0.5, "rgb": [0, 0, 0], "within": 0.04 } } },
    { "do": "show.seek", "t": 1, "settle": 1200 },
    { "do": "show.blockParam", "clip": "leftBlock", "name": "baseColor", "value": [1, 0, 1, 1] },
    { "do": "show.seek", "t": 1.02, "settle": 1200, "label": "The left block's colour edited in the panel: magenta now, on that block only",
      "expect": { "output.region": { "x0": 0, "x1": 0.5, "rgb": [1, 0, 1], "within": 0.06 },
        "eval.true": { "js": "JSON.stringify(__show.layerByName('Left').source.shaderValues.baseColor) === '[1,1,1,1]'", "label": "the mapping layer is untouched" } } },
    { "do": "show.seek", "t": 5, "settle": 1200, "label": "Later the left piece is still hidden; the right still yellow",
      "expect": { "output.region": { "x0": 0.5, "x1": 1, "rgb": [1, 1, 0], "within": 0.08 }, "noErrors": true } }
  ]
}
