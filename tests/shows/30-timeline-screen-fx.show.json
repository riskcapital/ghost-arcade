{
  "name": "Timeline: Screen FX and composition effect blocks",
  "description": "Three pieces (red, green, blue). A strobe block on the Timeline's Screen FX row flashes every piece only inside its span; an Effects row block switches Invert on for its span; a linear sweep crossfades into a beat pulse. Checked on the render core's real pixels, then scrubbed back.",
  "steps": [
    { "do": "app.start", "choice": "blank" },
    { "do": "project.layer", "name": "Left", "colour": "red", "x0": 0, "x1": 0.3 },
    { "do": "project.layer", "name": "Middle", "colour": "green", "x0": 0.35, "x1": 0.65 },
    { "do": "project.layer", "name": "Right", "colour": "blue", "x0": 0.7, "x1": 1, "wait": 1 },
    { "do": "show.open", "doc": "timeline" },
    { "do": "show.stageBlock", "row": "screenfx", "at": 2, "duration": 2, "type": "strobe", "params": { "rate": 2, "duty": 0.5 } },
    { "do": "show.stageBlock", "row": "effects", "at": 6, "duration": 2, "type": "invert", "params": { "invertMode": 0, "invertAmount": 1 } },
    { "do": "show.stageBlock", "row": "screenfx", "at": 10, "duration": 6, "type": "linear-sweep", "params": { "angle": 0, "speed": 0.5, "bandWidth": 0.2, "tail": 0 } },
    { "do": "show.stageBlock", "row": "screenfx", "at": 14, "duration": 6, "type": "beat-pulse", "params": { "decay": 0.2 } },
    { "do": "show.seek", "t": 1, "settle": 1500, "label": "t=1: before the strobe: Left at its own red",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "rgb": [1, 0, 0] } } },
    { "do": "show.seek", "t": 2.1, "settle": 800, "label": "t=2.1: strobe on: Left red",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "rgb": [1, 0, 0] } } },
    { "do": "show.seek", "t": 2.4, "settle": 800, "label": "t=2.4: strobe off: Left dark",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "max": 0.02 } } },
    { "do": "show.seek", "t": 2.41, "settle": 200, "label": "t=2.4: strobe off: Right dark too",
      "expect": { "output.region": { "x0": 0.73, "x1": 0.97, "max": 0.02 } } },
    { "do": "show.seek", "t": 2.6, "settle": 800, "label": "t=2.6: strobe on again: Middle green",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "rgb": [0, 1, 0] } } },
    { "do": "show.seek", "t": 5, "settle": 800, "label": "t=5: after the strobe (between blocks): no Screen FX",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "rgb": [0, 1, 0] } } },
    { "do": "show.seek", "t": 6.5, "settle": 1000, "label": "t=6.5: the Invert block: Left cyan",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "rgb": [0, 1, 1] } } },
    { "do": "show.seek", "t": 8.1, "settle": 1000, "label": "t=8.1: after the Invert block: Left red",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "rgb": [1, 0, 0] } } },
    { "do": "show.seek", "t": 10.9, "settle": 800, "label": "t=10.9: the sweep is on Left",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "min": 0.15 } } },
    { "do": "show.seek", "t": 10.91, "settle": 200, "label": "t=10.9: Middle dark",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "max": 0.02 } } },
    { "do": "show.seek", "t": 11.75, "settle": 800, "label": "t=11.75: the sweep has moved to Middle",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "min": 0.15 } } },
    { "do": "show.seek", "t": 11.76, "settle": 200, "label": "t=11.75: Left dark",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "max": 0.02 } } },
    { "do": "show.seek", "t": 15, "settle": 800, "label": "t=15: half way through the crossfade: Middle half lit (sweep off, pulse on)",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "rgb": [0, 0.5, 0], "within": 0.06 } } },
    { "do": "show.seek", "t": 17, "settle": 800, "label": "t=17: the pulse alone, on the beat: Middle green",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "rgb": [0, 1, 0], "within": 0.06 } } },
    { "do": "show.seek", "t": 17.3, "settle": 800, "label": "t=17.3: the pulse has decayed: Middle dark",
      "expect": { "output.region": { "x0": 0.38, "x1": 0.62, "max": 0.02 } } },
    { "do": "show.seek", "t": 2.4, "settle": 800, "label": "Scrubbed back to t=2.4: dark again",
      "expect": { "output.region": { "x0": 0.03, "x1": 0.27, "max": 0.02 }, "noErrors": true } }
  ]
}
