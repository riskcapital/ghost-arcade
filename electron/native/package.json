{
  "name": "spout-addon",
  "version": "0.1.0",
  "description": "Spout2 native addon for Electron — zero-copy GPU texture sharing",
  "main": "build/Release/spout_addon.node",
  "private": true,
  "scripts": {
    "install": "cmake-js compile",
    "build": "node scripts/build-native.mjs",
    "build:single": "cmake-js compile --runtime=electron --runtime-version=42.0.0",
    "rebuild": "node scripts/build-native.mjs --rebuild",
    "rebuild:single": "cmake-js rebuild --runtime=electron --runtime-version=42.0.0",
    "clean": "cmake-js clean"
  },
  "dependencies": {
    "cmake-js": "^7.3.0",
    "node-addon-api": "^8.3.1"
  }
}
